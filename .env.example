# =============================================
# ORION - Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores
# =============================================

# Porta do servidor
PORT=3000

# OpenCellID - Base de torres de celular
OPENCELLID_API_KEY=pk.d597db3bcf9eea4d67acaeb057573fd4

# Telegram - Notificações de alerta
TELEGRAM_BOT_TOKEN=seu_token_do_bot_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Luxand / DeepFace (reconhecimento facial)
LUXAND_API_KEY=seu_token_luxand
DEEPFACE_API_KEY=seu_token_deepface

# SerpAPI (buscas OSINT)
SERPAPI_KEY=seu_token_serpapi

# Caminhos dos bancos de dados
SQLITE_CELL_DB=./data/cell_towers.db
SQLITE_ORION_DB=./data/orion.db

# Modo de desenvolvimento
NODE_ENV=production
